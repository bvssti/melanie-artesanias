# ============================================================
# ARTESANÍAS MELANIE — variables de entorno
# ============================================================
# Copia este archivo como ".env.local" y rellena los valores.
# .env.local NUNCA debe subirse a Git.

# --- Supabase ---
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# --- Mercado Pago ---
# Dashboard → Tus integraciones → (tu app) → Credenciales de producción
# Para sandbox usa el Access Token de prueba.
MP_ACCESS_TOKEN=APP_USR-xxxxx...
MP_WEBHOOK_SECRET=tu-secret-para-validar-webhooks

# Si estás probando, pon true para que el frontend redirija al sandbox
NEXT_PUBLIC_MP_SANDBOX=true

# --- App ---
# URL pública del sitio (sin slash final).
# En desarrollo: http://localhost:3000
# En producción: https://artesaniasmelanie.cl (o tu dominio Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
